# All optional. Copy to .env to use.
PORT=3000
# Length of each conversation.
ROUND_SECONDS=180
# Use Claude to read resumes. Without it, a built-in keyword parser is used.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# WebRTC servers as JSON. Add TURN for production, or video fails on many networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
# Number of proxies in front of the app, so rate limiting sees real client IPs.
# TRUST_PROXY=1
